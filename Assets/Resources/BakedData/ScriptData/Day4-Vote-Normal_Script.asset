  dialogueLines:
  - ID: 0
    speakerPosition: Left
    speakerName: "\uC81C\uC784\uC2A4"
    listenerName: 
    dialogueText: "\uB2E4\uB4E4 \uBAA8\uC600\uB098. \uB9C9\uB0B4, \uB10C \uC624\uB298
      \uC5C5\uBB34\uB97C \uC798 \uB05D\uB0C8\uB354\uAD70. \uC774 \uB054\uCC0D\uD55C
      \uBD84\uC704\uAE30 \uC18D\uC5D0\uC11C\uB3C4 \uB10C \uD754\uB4E4\uB9BC\uC774
      \uC5C6\uC5B4\uC11C \uB2E4\uD589\uC774\uC57C."
    nextID: 1
    events: []
    emotion: 
    choices:
