  - ID: 3
    speakerPosition: Left
    speakerName: "\uC81C\uC784\uC2A4"
    listenerName: 
    dialogueText: "\uC774 \uC0C1\uC790\uB294 \uC18C\uD53C\uC544 \uD560\uBA38\uB2C8
      \uBC29\uC5D0 \uC788\uB358 \uAC70\uC796\uC544. \uBA40\uCA61\uD55C \uC2DD\uB7C9\uB4E4\uC744
      \uC9D3\uC774\uACA8\uB193\uB2E4\uB2C8... \uC81C\uC815\uC2E0\uC774 \uC544\uB2C8\uAD70."
