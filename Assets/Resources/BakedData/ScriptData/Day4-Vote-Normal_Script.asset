  - ID: 1
    speakerPosition: Left
    speakerName: "\uC81C\uC784\uC2A4"
    listenerName: 
    dialogueText: "\uC5B4\uC81C\uC624\uB298 \uB204\uAD70\uAC00 \uB300\uD53C\uC18C\uB97C
      \uC5C9\uB9DD\uC73C\uB85C \uB9CC\uB4E4\uACE0 \uC788\uB2E4. \uC624\uB298 \uACB0\uC815\uC801\uC778
      \uB2E8\uC11C\uB97C \uCC3E\uC740 \uC0AC\uB78C \uC788\uB098?"
    nextID: 
    events: []
    emotion: 
    choices:
    - text: "\uC544\uBB34\uAC83\uB3C4 \uC5C6\uC5C8\uC2B5\uB2C8\uB2E4."
      nextID: 4
      effects: []
      requiredEvidence: 0
    - text: "\uB204\uAD70\uAC00 \uD6D4\uCE5C \uBB3C\uAC74\uC785\uB2C8\uB2E4."
      nextID: 2
      effects:
      - effectType: 1
        effectSubject: 2
        effectTarget: 3
        effectAmount: 15
      - effectType: 1
        effectSubject: 4
        effectTarget: 3
        effectAmount: 15
      - effectType: 1
        effectSubject: 5
        effectTarget: 3
        effectAmount: 15
      requiredEvidence: 12
    - text: "\uAE30\uAD34\uD558\uAC8C \uB9DD\uAC00\uC9C4 \uC0C1\uC790\uC785\uB2C8\uB2E4."
      nextID: 3
      effects:
      - effectType: 1
        effectSubject: 2
        effectTarget: 5
        effectAmount: 15
      - effectType: 1
        effectSubject: 3
        effectTarget: 5
        effectAmount: 15
      - effectType: 1
        effectSubject: 4
        effectTarget: 5
        effectAmount: 15
      requiredEvidence: 13
  - ID: 2
    speakerPosition: Left
    speakerName: "\uC81C\uC784\uC2A4"
    listenerName: 
    dialogueText: "\uB2C8\uCF5C\uB77C\uC2A4... \uCC3D\uACE0 \uBB3C\uAC74\uC744 \uBE7C\uB3CC\uB9B0
      \uAC8C \uB108\uC600\uB098? \uB124\uB188\uC774 \uB4A4\uC5D0\uC11C \uD5C8\uD2BC\uC218\uC791\uC744
      \uBD80\uB9AC\uACE0 \uC788\uC5C8\uAD70."
    nextID: 4
