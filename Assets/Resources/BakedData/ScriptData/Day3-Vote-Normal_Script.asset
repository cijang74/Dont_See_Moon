  - ID: 3
    speakerPosition: Left
    speakerName: "\uC81C\uC784\uC2A4"
    listenerName: 
    dialogueText: "\uC18C\uD53C\uC544 \uD560\uBA38\uB2C8, \uBB3C\uC744 \uC5CE\uC9C0\uB974\uC168\uB2E4\uACE0\uC694?
      \uC5B4\uC81C\uBD80\uD130 \uACC4\uC18D \uC816\uC5B4\uC788\uB358 \uC7A1\uC9C0\uC778\uB370
      \uC55E\uB4A4\uAC00 \uC548 \uB9DE\uC9C0 \uC54A\uC2B5\uB2C8\uAE4C."
