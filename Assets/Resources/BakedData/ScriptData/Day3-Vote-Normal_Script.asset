  title: 
  dialogueLines:
  - ID: 0
    speakerPosition: Left
    speakerName: "\uC81C\uC784\uC2A4"
    listenerName: 
    dialogueText: "\uB2E4 \uBAA8\uC600\uAD70. \uB9C9\uB0B4, \uC624\uB298\uB3C4 \uB124
      \uBAAB\uC744 \uB2E4\uD574\uC918\uC11C \uACE0\uB9D9\uB2E4. \uC0C1\uD669\uC774
      \uD5D8\uC545\uD574\uB3C4 \uC77C\uACFC\uB294 \uC911\uC694\uD558\uB2C8\uAE4C."
    nextID: 1
    events: []
    emotion: 
    choices:
    - text: 
      nextID: 
      effects: []
      requiredEvidence: 0
    - text: 
      nextID: 
      effects: []
