  - ID: 1
    speakerPosition: Left
    speakerName: "\uC81C\uC784\uC2A4"
    listenerName: 
    dialogueText: "\uADF8\uB7FC \uD68C\uC758\uB97C \uC2DC\uC791\uD558\uC9C0. \uD639\uC2DC
      \uC624\uB298 \uB204\uAD6C \uC218\uC0C1\uD55C \uD589\uB3D9\uC744 \uD558\uAC70\uB098
      \uD754\uC801\uC744 \uB0A8\uAE34 \uAC78 \uBCF8 \uC0AC\uB78C \uC788\uB098?"
    nextID: 
    events: []
    emotion: 
    choices:
    - text: "\uC544\uBB34\uAC83\uB3C4 \uC5C6\uC5C8\uC2B5\uB2C8\uB2E4."
      nextID: 4
      effects: []
      requiredEvidence: 0
    - text: "\uC774\uC0C1\uD55C \uBA54\uBAA8\uC9C0\uB97C \uCC3E\uC558\uC2B5\uB2C8\uB2E4."
      nextID: 2
      effects:
      - effectType: 1
        effectSubject: 2
        effectTarget: 3
        effectAmount: 15
      - effectType: 1
        effectSubject: 4
        effectTarget: 3
        effectAmount: 15
      - effectType: 1
        effectSubject: 5
        effectTarget: 3
        effectAmount: 15
      requiredEvidence: 10
    - text: "\uC816\uC740 \uC7A1\uC9C0 \uB354\uBBF8\uB97C \uCC3E\uC558\uC2B5\uB2C8\uB2E4."
      nextID: 3
      effects:
      - effectType: 1
        effectSubject: 2
        effectTarget: 5
        effectAmount: 15
      - effectType: 1
        effectSubject: 3
        effectTarget: 5
        effectAmount: 15
      - effectType: 1
        effectSubject: 4
        effectTarget: 5
        effectAmount: 15
      requiredEvidence: 11
  - ID: 2
    speakerPosition: Left
    speakerName: "\uC81C\uC784\uC2A4"
    listenerName: 
    dialogueText: "\uC774\uAC74... \uBC30\uC804\uC2E4\uC758 \uB2C8\uCF5C\uB77C\uC2A4\uAC00
      \uC801\uC740 \uAC74\uAC00? \uC804\uB825 \uACC4\uC0B0\uC2DD \uCE58\uACE0\uB294
      \uC544\uC8FC \uAE30\uAD34\uD558\uAD70. \uD574\uBA85\uC774 \uD544\uC694\uD558\uACA0\uC5B4."
    nextID: 4
    events: []
    emotion: 
    choices:
    - text: 
      nextID: 
      effects: []
      requiredEvidence: 0
    - text: 
      nextID: 
      effects: []
