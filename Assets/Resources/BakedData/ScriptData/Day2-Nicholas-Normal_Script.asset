    speakerName: "\uB2C8\uCF5C\uB77C\uC2A4"
    listenerName: 
    dialogueText: "\uC5EC\uAE34 \uC5B4\uCA50 \uC77C\uC774\uC57C? \uBC30\uC804\uC2E4\uC740
      \uB0B4 \uAD6C\uC5ED\uC778\uB370. \uBB50, \uC2EC\uC2EC\uD558\uBA74 \uB4E4\uC5B4\uC640\uB3C4
