  - ID: 1
    speakerPosition: Left
    speakerName: "\uB2C8\uCF5C\uB77C\uC2A4"
    listenerName: 
    dialogueText: "\uB0B4 \uAE30\uC220\uB825 \uC54C\uC9C0? \uB098\uB9CC \uD55C \uC815\uBE44\uC0AC\uAC00
      \uC788\uC73C\uB2C8 \uC774 \uB300\uD53C\uC18C\uAC00 \uB3CC\uC544\uAC00\uB294
      \uAC70\uB77C\uACE0. \uC0AC\uC2E4 \uB0B4 \uB2A5\uB825\uACFC \uBB3C\uC790\uB9CC
      \uC788\uC73C\uBA74 \uBC16\uC5D0\uC11C\uB3C4 \uB044\uB5A1\uC5C6\uC9C0."
