  - ID: 3
    speakerPosition: Left
    speakerName: "\uB2C8\uCF5C\uB77C\uC2A4"
    listenerName: 
    dialogueText: "\uC544\uBB34\uD2BC \uB09C \uBC14\uC058\uB2C8\uAE4C \uC774\uB9CC
      \uAC00\uBD10. \uB098\uC911\uC5D0 '\uC9C4\uC9DC \uC0DD\uC874'\uC5D0 \uB300\uD574
      \uC598\uAE30\uD560 \uAE30\uD68C\uAC00 \uC788\uC744\uC9C0\uB3C4 \uBAA8\uB974\uC9C0."
