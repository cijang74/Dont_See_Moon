  - ID: 2
    speakerPosition: Left
    speakerName: "\uB2C8\uCF5C\uB77C\uC2A4"
    listenerName: 
    dialogueText: "\uC544, \uC18C\uD53C\uC544 \uD560\uBA38\uB2C8 \uB9D0\uC774\uC57C?
      \uB300\uD53C\uC18C\uC5D0 \uC624\uAE30 \uC804\uBD80\uD130 \uC606\uC9D1 \uC0B4\uB358
      \uC774\uC6C3\uC774\uC5C8\uC5B4. \uB0B4\uAC00 \uCC59\uACA8\uC11C \uC5EC\uAE30\uAE4C\uC9C0
      \uBAA8\uC2DC\uACE0 \uC628 \uAC70\uC9C0."
