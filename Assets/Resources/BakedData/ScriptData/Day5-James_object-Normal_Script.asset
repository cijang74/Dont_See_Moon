    speakerName: "\uC8FC\uC778\uACF5"
    listenerName: 
    dialogueText: "\uD3C9\uC18C \uCCA0\uC800\uD558\uAC8C \uB300\uD53C\uC18C\uB97C
      \uAD00\uB9AC\uD558\uB358 \uC81C\uC784\uC2A4\uB2F5\uC9C0 \uC54A\uC740 \uD589\uB3D9\uC774\uC57C.
      \uBB34\uC5B8\uAC00\uB97C \uC228\uAE30\uB824 \uD558\uAC70\uB098, \uC81C\uC815\uC2E0\uC774
