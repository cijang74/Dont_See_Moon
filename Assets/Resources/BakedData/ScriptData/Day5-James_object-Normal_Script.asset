  - ID: 2
    speakerPosition: Left
    speakerName: "\uC8FC\uC778\uACF5"
    listenerName: 
    dialogueText: "\uC774 \uC704\uD5D8\uD55C \uC2DC\uAD6D\uC5D0 \uC65C \uAC11\uC790\uAE30
      \uBB3C\uAC74\uB4E4\uC744 \uBC84\uB9AC\uB824\uB294 \uAC70\uC9C0? \uADF8\uAC83\uB3C4
      \uC774\uB807\uAC8C \uBB34\uC758\uBBF8\uD55C \uC4F0\uB808\uAE30\uB4E4\uC744\u2026"
