  - ID: 1
    speakerPosition: Left
    speakerName: "\uC8FC\uC778\uACF5"
    listenerName: 
    dialogueText: "\uC790\uC138\uD788 \uBCF4\uB2C8 \uB300\uBD80\uBD84 \uC4F8\uBAA8\uC5C6\uB294
      \uC7A1\uB3D9\uC0AC\uB2C8\uB4E4\uBFD0\uC774\uC57C. \uBC16\uC73C\uB85C \uB0B4\uB2E4
      \uBC84\uB9AC\uAE30 \uC704\uD574 \uBB34\uC791\uC815 \uC313\uC544\uB454 \uBAA8\uC2B5\uC774\uB2E4."
