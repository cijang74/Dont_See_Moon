    speakerName: "\uC8FC\uC778\uACF5"
    listenerName: 
    dialogueText: "\uB300\uD53C\uC18C \uCD9C\uC785\uAD6C \uC55E\uC5D0 \uB204\uAD70\uAC00\uC758
      \uBB3C\uAC74\uB4E4\uC774 \uC794\uB729 \uC313\uC5EC \uC788\uB2E4. \uC81C\uC784\uC2A4\uC758
