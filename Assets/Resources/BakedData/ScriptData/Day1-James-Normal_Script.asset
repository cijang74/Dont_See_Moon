    speakerName: "\uC81C\uC784\uC2A4"
    listenerName: 
    dialogueText: "\uD14C\uC624 \uC77C\uB85C \uB2E4\uB4E4 \uC608\uBBFC\uD55C \uC0C1\uD0DC\uB2E4.
