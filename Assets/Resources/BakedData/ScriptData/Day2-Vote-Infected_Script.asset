  - ID: 1
    speakerPosition: Left
    speakerName: "\uC81C\uC784\uC2A4"
    listenerName: 
    dialogueText: "\uC774\uB534 \uC2DD\uC73C\uB85C \uAD74\uBA74 \uB110 \uD22C\uD45C\uC7A5\uC5D0
      \uC62C\uB9B4 \uC218\uBC16\uC5D0 \uC5C6\uC5B4. \u2026\uC544\uBB34\uD2BC, \uC624\uB298
      \uC218\uC0C1\uD55C \uD754\uC801\uC744 \uCC3E\uC740 \uC0AC\uB78C \uC788\uB098?"
    nextID: 
    events: []
    emotion: 
    choices:
    - text: "\uC544\uBB34\uAC83\uB3C4 \uC5C6\uC5C8\uC2B5\uB2C8\uB2E4."
      nextID: 4
      effects:
      - effectType: 1
        effectSubject: 2
        effectTarget: 1
        effectAmount: 15
      - effectType: 1
        effectSubject: 4
        effectTarget: 1
        effectAmount: 15
      - effectType: 1
        effectSubject: 5
        effectTarget: 1
        effectAmount: 15
      - effectType: 1
        effectSubject: 0
        effectTarget: 0
        effectAmount: 0
      requiredEvidence: 0
    - text: "\uC57C\uAD6C \uBC30\uD2B8\uB97C \uBC1C\uACAC\uD588\uC2B5\uB2C8\uB2E4."
      nextID: 2
      effects:
      - effectType: 1
        effectSubject: 2
        effectTarget: 4
        effectAmount: 15
      - effectType: 1
        effectSubject: 3
        effectTarget: 4
        effectAmount: 15
      - effectType: 1
        effectSubject: 5
        effectTarget: 4
        effectAmount: 15
      requiredEvidence: 8
    - text: "\uBE68\uB798 \uBC14\uAD6C\uB2C8\uB97C \uBC1C\uACAC\uD588\uC2B5\uB2C8\uB2E4."
      nextID: 3
      effects: []
      requiredEvidence: 9
  - ID: 2
    speakerPosition: Left
    speakerName: "\uC81C\uC784\uC2A4"
    listenerName: 
    dialogueText: "\uC774 \uBC30\uD2B8... \uC5D8\uB77C, \uB124\uAC00 \uBC24\uC5D0
      \uBABD\uC720\uBCD1\uC774\uB77C\uB3C4 \uC553\uACE0 \uC788\uB294 \uAC74\uAC00?
      \uC544\uC8FC \uC758\uC2EC\uC2A4\uB7EC\uC6B4 \uD754\uC801\uC774\uAD70."
    nextID: 4
    events: []
