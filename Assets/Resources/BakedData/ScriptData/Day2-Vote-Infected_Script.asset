  title: 
  dialogueLines:
  - ID: 0
    speakerPosition: Left
    speakerName: "\uC81C\uC784\uC2A4"
    listenerName: 
    dialogueText: "\uB2E4\uB4E4 \uBAA8\uC600\uAD70. \uB9C9\uB0B4, \uC624\uB298 \uB124
      \uC5C5\uBB34\uB97C \uC81C\uB300\uB85C \uC548 \uD588\uB354\uAD70. \uC758\uC2EC\uBC1B\uAE30
      \uB531 \uC88B\uC740 \uD589\uB3D9\uC778 \uAC74 \uC54C\uACE0 \uC788\uB098?"
    nextID: 1
    events: []
    emotion: 
    choices:
    - text: 
      nextID: 
      effects: []
      requiredEvidence: 0
    - text: 
      nextID: 
