  - ID: 1
    speakerPosition: Left
    speakerName: "\uB2C8\uCF5C\uB77C\uC2A4"
    listenerName: 
    dialogueText: "\uC800\uAE30, \uB10C \uC5B4\uB5BB\uAC8C \uC0DD\uAC01\uD574? \uBC16\uC5D0\uC11C
      \uC0DD\uC874\uD558\uB294 \uAC8C\u2026 \uC774 \uB2F5\uB2F5\uD55C \uB300\uD53C\uC18C\uC5D0\uC11C
      \uC18D \uBAA8\uB97C \uC0AC\uB78C\uB4E4\uACFC \uC9C0\uB0B4\uB294 \uAC83\uBCF4\uB2E4
      \uB0AB\uC9C0 \uC54A\uC744\uAE4C?"
