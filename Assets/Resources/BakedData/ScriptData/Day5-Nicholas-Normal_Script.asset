    speakerName: "\uB2C8\uCF5C\uB77C\uC2A4"
    listenerName: 
    dialogueText: "\uC801\uC5B4\uB3C4 \uBC16\uC5D0\uC11C\uB294 \uB204\uAC00 \uAD34\uBB3C\uC774\uACE0
      \uB204\uAC00 \uC0AC\uB78C\uC778\uC9C0, \uB208\uC5D0 \uBE64\uD788 \uBCF4\uC77C
      \uD14C\uB2C8\uAE4C \uB9D0\uC774\uC57C."
