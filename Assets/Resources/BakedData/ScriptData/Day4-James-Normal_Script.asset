    speakerName: "\uC81C\uC784\uC2A4"
    listenerName: 
    dialogueText: "\uC7A0\uBCF5\uAE30\uC778 \uAC10\uC5FC\uC790 \uB54C\uBB38\uC778\uC9C0,
