    speakerName: "\uC8FC\uC778\uACF5"
    listenerName: 
    dialogueText: "(\uC7A0\uAE50, \uC774 \uC7A1\uC9C0\uB294 \uBD84\uBA85 \uC5B4\uC81C\uB3C4
