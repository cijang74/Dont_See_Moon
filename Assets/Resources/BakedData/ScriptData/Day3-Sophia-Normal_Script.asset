  - ID: 2
    speakerPosition: Left
    speakerName: "\uC18C\uD53C\uC544"
    listenerName: 
    dialogueText: "\uC5B4\uCC28\uD53C \uC2DC\uB4E4\uC5B4\uAC08 \uC6B4\uBA85\uC774\uB77C\uBA74,
      \uBB3C \uB300\uC2E0 \uB0A8\uB294 \uCEE4\uD53C\uB098 \uC74C\uB8CC\uC218\uB97C
      \uBD80\uC5B4\uC8FC\uB294 \uAC74 \uC5B4\uB5A8\uAE4C \uC2F6\uC5B4\uC11C\uC694."
    nextID: 
    events: []
    emotion: 
    choices:
