  - ID: 0
    speakerPosition: Left
    speakerName: "\uC18C\uD53C\uC544"
    listenerName: 
    dialogueText: "\uC5B4\uBA38, \uBC8C\uC368 \uC2DC\uAC04\uC774 \uC774\uB807\uAC8C
      \uB410\uB098. \uC774 \uD654\uBD84\uC5D0 \uC78E\uC774 \uB9D0\uB77C\uAC00\uB294
      \uAC78 \uBCF4\uACE0 \uC788\uC5C8\uC9C0 \uBB50\uC608\uC694."
