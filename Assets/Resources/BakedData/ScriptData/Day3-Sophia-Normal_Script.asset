  - ID: 1
    speakerPosition: Left
    speakerName: "\uC18C\uD53C\uC544"
    listenerName: 
    dialogueText: "\uBB3C\uC774 \uBD80\uC871\uD574\uC11C \uADF8\uB7F0 \uAC74\uC9C0,
      \uC544\uB2C8\uBA74 \uC774 \uB300\uD53C\uC18C \uACF5\uAE30\uAC00 \uD0C1\uD574\uC11C
      \uADF8\uB7F0 \uAC74\uC9C0\u2026 \uCC38 \uC548\uD0C0\uAE5D\uC8E0?"
    nextID: 
    events: []
    emotion: 
    choices:
    - text: 
      nextID: 
