  - ID: 3
    speakerPosition: Left
    speakerName: "\uC18C\uD53C\uC544"
    listenerName: 
    dialogueText: "\uD638\uD638, \uB18D\uB2F4\uC774\uC5D0\uC694. \uAE30\uC655 \uC8FD\uC744
      \uAC70\uBA74 \uB2EC\uCF64\uD558\uAC8C \uAC00\uB294 \uAC83\uB3C4 \uB098\uC058\uC9C0
      \uC54A\uACA0\uB2E4\uB294 \uB299\uC740\uC774\uC758 \uC2E4\uC5C6\uB294 \uC18C\uB9AC\uB78D\uB2C8\uB2E4."
