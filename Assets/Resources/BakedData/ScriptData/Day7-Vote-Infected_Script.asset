        effectSubject: 3
        effectTarget: 4
        effectAmount: 15
      - effectType: 1
        effectSubject: 5
        effectTarget: 4
        effectAmount: 15
      requiredEvidence: 16
    - text: "\uB354\uB7EC\uC6B4 \uC811\uC2DC\uB97C \uBC1C\uACAC\uD588\uC2B5\uB2C8\uB2E4."
      nextID: 3
