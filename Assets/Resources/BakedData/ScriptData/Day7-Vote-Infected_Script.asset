      - effectType: 1
        effectSubject: 0
        effectTarget: 0
        effectAmount: 0
      requiredEvidence: 0
    - text: "\uD0C1\uC0C1 \uC561\uC790\uB97C \uBC1C\uACAC\uD588\uC2B5\uB2C8\uB2E4."
      nextID: 2
