  - ID: 1
    speakerPosition: Left
    speakerName: "\uC81C\uC784\uC2A4"
    listenerName: 
    dialogueText: "\uC774 \uB300\uD53C\uC18C\uB97C \uC704\uD611\uD558\uB294 \uAC10\uC5FC\uC790\uAC00
      \uB204\uAD6C\uC778\uC9C0, \uB9C8\uC9C0\uB9C9\uC73C\uB85C \uC99D\uAC70\uB97C
      \uC81C\uC2DC\uD574\uB77C. \uC544\uBB34\uAC83\uB3C4 \uC5C6\uB098?"
    nextID: 
    events: []
    emotion: 
    choices:
    - text: "\uC544\uBB34\uAC83\uB3C4 \uC5C6\uC5C8\uC2B5\uB2C8\uB2E4."
      nextID: 4
      effects:
      - effectType: 1
