    speakerName: "\uC18C\uD53C\uC544"
    listenerName: 
    dialogueText: "\uC544\uC720, \uC6B0\uB9AC \uB9C9\uB0B4 \uB610 \uBCF4\uB124. \uB299\uC740\uC774\uB294
      \uAC70\uC2E4\uC5D0 \uC774\uB807\uAC8C \uC11C\uC11C \uC0AC\uB78C \uAD6C\uACBD\uD558\uB294
