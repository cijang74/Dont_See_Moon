  - ID: 2
    speakerPosition: Left
    speakerName: "\uC18C\uD53C\uC544"
    listenerName: 
    dialogueText: "\uADF8\uB098\uC800\uB098, \uB610 \uCD9C\uCD9C\uD558\uC9C4 \uC54A\uC544\uC694?
      \uBA38\uB9AC\uAC00 \uBCF5\uC7A1\uD560 \uB550 \uC8FC\uBC29\uC5D0 \uAC00\uC11C
      \uCFE0\uD0A4\uB77C\uB3C4 \uC539\uC5B4 \uBA39\uB294 \uAC8C \uCD5C\uACE0\uB78D\uB2C8\uB2E4."
