  - ID: 1
    speakerPosition: Left
    speakerName: "\uC18C\uD53C\uC544"
    listenerName: 
    dialogueText: "\uB2E4\uB4E4 \uC800\uB9C8\uB2E4 \uBC14\uC058\uAC8C \uB3CC\uC544\uB2E4\uB2C8\uB294
      \uAC78 \uBCF4\uBA74 \uCC38 \uC7AC\uBC0C\uB2E8 \uB9D0\uC774\uC57C. \uC81C\uC784\uC2A4\uB294
      \uC544\uCE68\uBD80\uD130 \uBA38\uB9AC\uB97C \uC950\uC5B4\uB72F\uACE0 \uC788\uACE0
      \uB9D0\uC774\uC9C0."
