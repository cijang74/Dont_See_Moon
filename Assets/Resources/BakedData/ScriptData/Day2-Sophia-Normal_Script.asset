  - ID: 3
    speakerPosition: Left
    speakerName: "\uC18C\uD53C\uC544"
    listenerName: 
    dialogueText: "\uB108\uBB34 \uBB34\uB9AC\uD558\uC9C0 \uB9C8\uC694. \uC6B0\uB9AC\uAC00
      \uD560 \uC218 \uC788\uB294 \uAC74 \uADF8\uC800\u2026 \uC870\uC6A9\uD788 \uD750\uB984\uC744
      \uC9C0\uCF1C\uBCF4\uB294 \uAC83\uBFD0\uC774\uB2C8\uAE4C\uC694."
