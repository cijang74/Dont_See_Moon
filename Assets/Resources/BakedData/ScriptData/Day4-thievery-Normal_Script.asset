    speakerName: "\uC8FC\uC778\uACF5"
    listenerName: 
    dialogueText: "(\uC790\uC2E0\uC758 \uACC4\uD68D\uC774 \uB4E4\uD1B5\uB0A0\uAE4C
      \uBD10 \uC774\uB807\uAC8C\uAE4C\uC9C0 \uB2E4\uAE09\uD558\uAC8C \uAC70\uB798\uB97C
      \uC2DC\uB3C4\uD558\uB2E4\uB2C8, \uB2C8\uCF5C\uB77C\uC2A4\uAC00 \uAC08\uC218\uB85D
