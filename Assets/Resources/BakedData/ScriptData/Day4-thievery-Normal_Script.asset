    speakerName: "\uB2C8\uCF5C\uB77C\uC2A4"
    listenerName: 
    dialogueText: "\uB300\uC2E0 \uC81C\uBC1C, \uC624\uB298 \uC77C\uC740 \uD55C \uBC88\uB9CC
      \uBAA8\uB978 \uCC44 \uD574\uB2EC\uB77C\uACE0. \uC57D\uC18D\uD55C \uAC70\uB2E4?"
