  - ID: 1
    speakerPosition: Right
    speakerName: "\uB2C8\uCF5C\uB77C\uC2A4"
    listenerName: 
    dialogueText: "\uC7A0\uAE50! \uADF8, \uADF8 \uBB3C\uAC74\uC740 \uB124\uAC00 \uAC00\uC838\uAC00\uB3C4
      \uC88B\uC544. \uC560\uCD08\uC5D0 \uB098\uD55C\uD14C \uC5C6\uC5C8\uB358 \uAC78\uB85C
      \uCE60 \uD14C\uB2C8\uAE4C."
