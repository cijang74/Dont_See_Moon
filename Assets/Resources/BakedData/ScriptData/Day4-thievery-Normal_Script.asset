  - ID: 0
    speakerPosition: Left
    speakerName: "\uC8FC\uC778\uACF5"
    listenerName: 
    dialogueText: "\uB2C8\uCF5C\uB77C\uC2A4 \uC606\uC5D0 \uBC29\uAE08 \uC804 \uADF8\uAC00
      \uCC59\uAE30\uB824\uB358 \uBB3C\uAC74\uB4E4\uC774 \uB193\uC5EC \uC788\uB2E4.
      \uCC59\uACA8\uB450\uBA74 \uC800\uB141 \uD22C\uD45C \uB54C \uC99D\uAC70\uB85C
      \uC4F8 \uC218 \uC788\uACA0\uC5B4."
