    speakerName: "\uB2C8\uCF5C\uB77C\uC2A4"
    listenerName: 
    dialogueText: "\uC544, \uC774\uAC70? \uBCC4\uAC70 \uC544\uB2C8\uC57C. \uB300\uD53C\uC18C
      \uB0B4 \uC804\uB825 \uC0AC\uC6A9\uB7C9\uC744 \uB2E4\uC2DC \uACC4\uC0B0\uD574
      \uBCF4\uACE0 \uC788\uC5C8\uC744 \uBFD0\uC774\uB77C\uACE0."
