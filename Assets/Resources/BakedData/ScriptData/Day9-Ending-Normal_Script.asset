  - ID: 2
    speakerPosition: Left
    speakerName: "\uC8FC\uC778\uACF5"
    listenerName: 
    dialogueText: "\uC544\uB2C8\uB77C\uACE0 \uC5B5\uC6B8\uD558\uB2E4\uACE0 \uC18C\uB9AC\uCCD0\uBD24\uC9C0\uB9CC,
      \uC774\uBBF8 \uC774\uC131\uC744 \uC783\uACE0 \uD76C\uC0DD\uC591\uC744 \uC6D0\uD558\uB358
      \uC0AC\uB78C\uB4E4\uC5D0\uAC8C \uB0B4 \uBAA9\uC18C\uB9AC\uB294 \uB2FF\uC9C0
      \uC54A\uC558\uB2E4."
