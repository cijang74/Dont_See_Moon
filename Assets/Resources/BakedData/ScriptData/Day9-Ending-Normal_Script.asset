  - ID: 1
    speakerPosition: Left
    speakerName: "\uC8FC\uC778\uACF5"
    listenerName: 
    dialogueText: "\uBCC0\uBA85\uD560 \uD2C8\uB3C4 \uC5C6\uC5C8\uB2E4. \uC81C\uC784\uC2A4\uB294
      \uD14C\uC624\uC5D0\uAC8C \uADF8\uB7AC\uB358 \uAC83\uCC98\uB7FC, \uC758\uC2EC\uC758
      \uD654\uC0B4\uC744 \uB0B4\uAC8C \uB3CC\uB838\uB2E4."
