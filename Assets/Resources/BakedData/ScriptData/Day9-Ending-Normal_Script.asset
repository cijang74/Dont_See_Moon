  - ID: 0
    speakerPosition: Left
    speakerName: "\uC8FC\uC778\uACF5"
    listenerName: 
    dialogueText: "\uC0AC\uB78C\uB4E4\uC758 \uC2DC\uC120\uC774 \uC77C\uC81C\uD788
      \uB098\uB97C \uD5A5\uD588\uB2E4. \uACF5\uD3EC\uC640 \uAD11\uAE30\uB85C \uC5BC\uB8E9\uC9C4,
      \uCC28\uAC00\uC6B4 \uB208\uBE5B\uB4E4."
