    speakerName: "\uC81C\uC784\uC2A4"
    listenerName: 
    dialogueText: "\uC774\uAC74 \uB9E4\uC6B0 \uC88B\uC9C0 \uC54A\uC740 \uC0C1\uD669\uC774\uB2E4.
      \uC678\uBD80\uC758 \uC801\uBCF4\uB2E4 \uB0B4\uBD80\uC758 \uBD88\uC2E0\uC774
      \uB300\uD53C\uC18C\uB97C \uBA3C\uC800 \uBB34\uB108\uB728\uB9B4 \uD14C\uB2C8\uAE4C."
