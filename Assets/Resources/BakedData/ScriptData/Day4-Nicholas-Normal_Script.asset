  - ID: 0
    speakerPosition: Left
    speakerName: "\uB2C8\uCF5C\uB77C\uC2A4"
    listenerName: 
    dialogueText: "\uD5C9\u2026! \uC544, \uAE5C\uC9DD\uC774\uC57C! \uC778\uAE30\uCC99
      \uC880 \uB0B4\uACE0 \uB2E4\uB2C8\uB77C\uB2C8\uAE4C!"
