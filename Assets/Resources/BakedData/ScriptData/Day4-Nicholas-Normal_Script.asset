  - ID: 3
    speakerPosition: Left
    speakerName: "\uB2C8\uCF5C\uB77C\uC2A4"
    listenerName: 
    dialogueText: "\uADF8\uB7EC\uB2C8\uAE4C \uB10C \uC5EC\uAE30\uC11C \uC544\uBB34\uAC83\uB3C4
      \uBABB \uBCF8 \uAC70\uB2E4? \uC81C\uC784\uC2A4 \uADC0\uC5D0 \uB4E4\uC5B4\uAC00\uBA74
      \uB10C \uD22C\uD45C\uAD8C\uC744 \uC783\uB294 \uC148\uC774\uB77C\uACE0."
