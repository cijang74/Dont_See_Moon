  - ID: 1
    speakerPosition: Left
    speakerName: "\uB2C8\uCF5C\uB77C\uC2A4"
    listenerName: 
    dialogueText: "\uC774, \uC774\uAC74 \uADF8\uB0E5\u2026 \uC7AC\uACE0\uAC00 \uC5BC\uB9C8\uB098
      \uB0A8\uC558\uB294\uC9C0 \uD655\uC778\uD574 \uBCF4\uB824\uB358 \uCC38\uC774\uC5C8\uC5B4.
      \uC808\uB300 \uD6D4\uCE58\uB824\uB358 \uAC8C \uC544\uB2C8\uB77C\uACE0!"
    nextID: 
    events: []
