  - ID: 2
    speakerPosition: Left
    speakerName: "\uB2C8\uCF5C\uB77C\uC2A4"
    listenerName: 
    dialogueText: "\uC88B\uC544, \uC194\uC9C1\uD558\uAC8C \uB9D0\uD558\uC9C0. \uC624\uB298
      \uC77C \uB208\uAC10\uC544\uC8FC\uBA74, \uC55E\uC73C\uB85C \uC800\uB141 \uD22C\uD45C
      \uB54C \uB110 \uCC0D\uB294 \uC77C\uC740 \uC808\uB300 \uC5C6\uC744 \uAC70\uC57C.
      \uC57D\uC18D\uD560\uAC8C."
    nextID: 
    events: []
    emotion: 
