  - ID: 4
    speakerPosition: Left
    speakerName: "\uC8FC\uC778\uACF5"
    listenerName: 
    dialogueText: "\uB2E4\uC2DC\uB294 \uC774\uACF3\uC5D0 \uB3CC\uC544\uC624\uC9C0
      \uC54A\uC744 \uAC83\uC774\uB2E4. \uC783\uC5B4\uBC84\uB9B0 \uB3D9\uC0DD\uC744
      \uCC3E\uAE30 \uC704\uD574, \uC544\uB2C8\uBA74 \uB098 \uC5ED\uC2DC \uC800 \uBC16\uC5D0\uC11C
      \uC8FD\uC74C\uC744 \uB9DE\uC774\uD558\uAE30 \uC704\uD574."
