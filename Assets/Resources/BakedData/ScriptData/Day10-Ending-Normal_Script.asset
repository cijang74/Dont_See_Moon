  - ID: 0
    speakerPosition: Left
    speakerName: "\uC8FC\uC778\uACF5"
    listenerName: 
    dialogueText: "\uC2DC\uAC04\uC774 \uB2E4 \uB418\uC5C8\uB2E4. \uC6B0\uB9AC\uB294
      \uB05D\uB0B4 \uB204\uAC00 \uAC10\uC5FC\uC790\uC778\uC9C0 \uCC3E\uC544\uB0B4\uC9C0
      \uBABB\uD588\uB2E4."
