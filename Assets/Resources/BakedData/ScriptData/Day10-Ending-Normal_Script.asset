  - ID: 2
    speakerPosition: Left
    speakerName: "\uC8FC\uC778\uACF5"
    listenerName: 
    dialogueText: "\uC774\uACF3\uC740 \uB354 \uC774\uC0C1 \uC548\uC804\uD55C \uB300\uD53C\uC18C\uAC00
      \uC544\uB2C8\uB2E4. \uADF8\uC800 \uAD73\uAC8C \uB2EB\uD78C \uAC70\uB300\uD55C
      \uBB34\uB364\uC77C \uBFD0."
    nextID: 3
    events: []
    emotion: 
    choices:
    - text: 
      nextID: 
