  - ID: 1
    speakerPosition: Left
    speakerName: "\uC8FC\uC778\uACF5"
    listenerName: 
    dialogueText: "\uB300\uD53C\uC18C \uB0B4\uBD80\uB294 \uC774\uBBF8 \uB054\uCC0D\uD558\uAC8C
      \uBD80\uD328\uD55C \uC0DD\uCCB4 \uC870\uC9C1\uACFC \uC804\uD30C\uB41C \uD3EC\uC790\uB85C
      \uB4A4\uB36E\uC600\uACE0, \uC0AC\uB78C\uB4E4\uC758 \uBE44\uBA85\uB9C8\uC800
      \uC7A6\uC544\uB4E4\uC5C8\uB2E4."
    nextID: 2
    events: []
    emotion: 
    choices:
    - text: 
      nextID: 
