  - ID: 3
    speakerPosition: Left
    speakerName: "\uC8FC\uC778\uACF5"
    listenerName: 
    dialogueText: "\uB098\uB294 \uBB34\uAC70\uC6B4 \uC774\uC911 \uBB38\uC744 \uC5F4\uACE0,
      \uD640\uB85C \uC9C0\uC625 \uAC19\uC740 \uBC16\uC73C\uB85C \uBC1C\uAC78\uC74C\uC744
      \uC62E\uACBC\uB2E4."
    nextID: 4
    events: []
    emotion: 
    choices:
    - text: 
      nextID: 
      effects: []
