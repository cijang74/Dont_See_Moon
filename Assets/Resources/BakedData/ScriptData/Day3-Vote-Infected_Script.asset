  - ID: 2
    speakerPosition: Left
    speakerName: "\uC81C\uC784\uC2A4"
    listenerName: 
    dialogueText: "\uC774\uAC74... \uBC30\uC804\uC2E4\uC758 \uB2C8\uCF5C\uB77C\uC2A4\uAC00
