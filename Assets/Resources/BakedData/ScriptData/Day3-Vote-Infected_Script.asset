  - ID: 1
    speakerPosition: Left
    speakerName: "\uC81C\uC784\uC2A4"
    listenerName: 
    dialogueText: "\uB204\uAD70\uAC00 \uC548\uC5D0\uC11C\uBD80\uD130 \uC6B0\uB9AC\uB97C
      \uAC09\uC544\uBA39\uACE0 \uC788\uC5B4. \uB2E4\uB4E4 \uACBD\uACC4\uD574. \uC790,
      \uC624\uB298 \uC218\uC0C1\uD55C \uC810\uC744 \uBC1C\uACAC\uD55C \uC0AC\uB78C
      \uC788\uB098?"
    nextID: 
    events: []
    emotion: 
    choices:
    - text: "\uC544\uBB34\uAC83\uB3C4 \uC5C6\uC5C8\uC2B5\uB2C8\uB2E4."
      nextID: 4
      effects:
      - effectType: 1
        effectSubject: 2
        effectTarget: 1
        effectAmount: 15
      - effectType: 1
        effectSubject: 4
        effectTarget: 1
        effectAmount: 15
      - effectType: 1
        effectSubject: 5
        effectTarget: 1
        effectAmount: 15
      - effectType: 1
        effectSubject: 0
        effectTarget: 0
        effectAmount: 0
      requiredEvidence: 0
    - text: "\uC774\uC0C1\uD55C \uBA54\uBAA8\uC9C0\uB97C \uCC3E\uC558\uC2B5\uB2C8\uB2E4."
      nextID: 2
      effects:
      - effectType: 1
        effectSubject: 2
        effectTarget: 3
        effectAmount: 15
      - effectType: 1
        effectSubject: 4
        effectTarget: 3
        effectAmount: 15
      - effectType: 1
        effectSubject: 5
        effectTarget: 3
        effectAmount: 15
      requiredEvidence: 10
    - text: "\uC816\uC740 \uC7A1\uC9C0 \uB354\uBBF8\uB97C \uCC3E\uC558\uC2B5\uB2C8\uB2E4."
      nextID: 3
