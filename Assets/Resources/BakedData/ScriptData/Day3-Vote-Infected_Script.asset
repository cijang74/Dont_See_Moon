  - ID: 0
    speakerPosition: Left
    speakerName: "\uC81C\uC784\uC2A4"
    listenerName: 
    dialogueText: "\uB9C9\uB0B4, \uC624\uB298\uB3C4 \uC5C5\uBB34\uB97C \uBE7C\uBA39\uC5C8\uB358\uB370.
