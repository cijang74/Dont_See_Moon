    listenerName: 
    dialogueText: "\uB2E4 \uBAA8\uC600\uAD70. \uB9C9\uB0B4, \uC624\uB298 \uB124 \uAD6C\uC5ED
      \uC5C5\uBB34\uB97C \uBE7C\uBA39\uC5C8\uB358\uB370. \uC9C0\uAE08 \uC774 \uB300\uD53C\uC18C
