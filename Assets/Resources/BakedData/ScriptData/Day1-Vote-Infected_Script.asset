    speakerName: "\uC81C\uC784\uC2A4"
    listenerName: 
    dialogueText: "\uB124 \uBAAB\uC744 \uC548 \uD558\uBA74 \uB0A8\uB4E4\uC774 \uC704\uD5D8\uD574\uC9C4\uB2E4\uB294
