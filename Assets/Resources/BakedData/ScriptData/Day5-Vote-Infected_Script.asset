  title: 
  dialogueLines:
  - ID: 0
    speakerPosition: Left
    speakerName: "\uC81C\uC784\uC2A4"
    listenerName: 
    dialogueText: "\uB9C9\uB0B4! \uB108 \uC624\uB298\uAE4C\uC9C0\uB3C4 \uC5C5\uBB34\uB97C
      \uC548 \uD588\uB354\uAD70. \uAC10\uC5FC\uC790\uAC00 \uC544\uB2C8\uB354\uB77C\uB3C4
      \uB10C \uB300\uD53C\uC18C\uC758 \uC554\uC801\uC778 \uC874\uC7AC\uB2E4."
    nextID: 1
    events: []
    emotion: 
    choices:
    - text: 
      nextID: 
      effects: []
      requiredEvidence: 0
    - text: 
