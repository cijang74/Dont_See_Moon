  - ID: 1
    speakerPosition: Left
    speakerName: "\uC81C\uC784\uC2A4"
    listenerName: 
    dialogueText: "\uB124\uAC00 \uC758\uC2EC\uBC1B\uAE30 \uC2EB\uB2E4\uBA74 \uC4F8\uBAA8
      \uC788\uB294 \uC815\uBCF4\uB97C \uB0B4\uB194. \uC624\uB298 \uB204\uAD70\uAC00\uC758
      \uC218\uC0C1\uD55C \uD754\uC801\uC744 \uCC3E\uC740 \uC0AC\uB78C \uC788\uB098?"
    nextID: 
    events: []
    emotion: 
    choices:
    - text: "\uC544\uBB34\uAC83\uB3C4 \uC5C6\uC5C8\uC2B5\uB2C8\uB2E4."
      nextID: 4
      effects:
      - effectType: 1
        effectSubject: 2
        effectTarget: 1
        effectAmount: 15
      - effectType: 1
        effectSubject: 4
        effectTarget: 1
        effectAmount: 15
      - effectType: 1
        effectSubject: 5
        effectTarget: 1
        effectAmount: 15
      - effectType: 1
        effectSubject: 0
        effectTarget: 0
        effectAmount: 0
      requiredEvidence: 0
    - text: "\uC785\uAD6C\uC5D0 \uC313\uC778 \uC9D0\uC744 \uBD24\uC2B5\uB2C8\uB2E4."
      nextID: 2
      effects: []
      requiredEvidence: 14
    - text: "\uAE30\uAD34\uD55C \uAD00\uCC30 \uC218\uCCA9\uC785\uB2C8\uB2E4."
      nextID: 3
      effects:
      - effectType: 1
        effectSubject: 2
        effectTarget: 4
        effectAmount: 15
      - effectType: 1
        effectSubject: 3
        effectTarget: 4
        effectAmount: 15
      - effectType: 1
        effectSubject: 5
        effectTarget: 4
        effectAmount: 15
      requiredEvidence: 15
  - ID: 2
    speakerPosition: Left
    speakerName: "\uC81C\uC784\uC2A4"
    listenerName: 
    dialogueText: "...\uADF8\uAC74 \uB0B4 \uAC1C\uC778 \uBB3C\uAC74\uB4E4\uC774\uB2E4.
      \uC4F8\uBAA8\uC5C6\uB294 \uAC83\uB4E4\uC744 \uC880 \uBC84\uB9AC\uB824 \uD588\uC744
      \uBFD0\uC774\uC57C. \uADF8\uAC78 \uC758\uC2EC\uC758 \uC99D\uAC70\uB77C\uACE0
      \uB4E4\uC774\uBBF8\uB294 \uAC70\uB0D0?"
    nextID: 4
    events: []
    emotion: 
    choices:
    - text: 
      nextID: 
      effects: []
      requiredEvidence: 0
    - text: 
      nextID: 
      effects: []
