  - ID: 3
    speakerPosition: Left
    speakerName: "\uC81C\uC784\uC2A4"
    listenerName: 
    dialogueText: "\uC774 \uC218\uCCA9\uC740 \uC5D8\uB77C\uC758 \uAC83\uC774\uAD70.
      \uC6B0\uB9AC \uBAA8\uB450\uC758 \uC77C\uAC70\uC218\uC77C\uD22C\uC871\uC744
      \uC774\uB807\uAC8C \uC9D5\uADF8\uB7FD\uAC8C \uAE30\uB85D\uD574\uB450\uB2E4\uB2C8...
