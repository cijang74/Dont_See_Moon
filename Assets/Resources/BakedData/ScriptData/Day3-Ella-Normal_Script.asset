  dialogueLines:
  - ID: 0
    speakerPosition: Left
    speakerName: "\uC5D8\uB77C"
    listenerName: 
    dialogueText: "\uC5EC\uAE34 \uC5B4\uCA50 \uC77C\uC774\uC57C? \uB09C \uADF8\uB0E5\u2026
      \uBCF5\uB3C4\uC5D0 \uADF8 \uC0AC\uB78C\uC774 \uC11C \uC788\uB294 \uAC8C \uC228
      \uB9C9\uD600\uC11C \uC7A0\uAE50 \uB4E4\uC5B4\uC628 \uAC70\uC57C."
