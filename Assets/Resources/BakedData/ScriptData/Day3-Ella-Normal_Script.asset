  - ID: 3
    speakerPosition: Left
    speakerName: "\uC5D8\uB77C"
    listenerName: 
    dialogueText: "\uB108\uB3C4 \uC870\uC2EC\uD574. \uC5B8\uC81C \uADF8 \uC0AC\uB78C\uC758
      \uD654\uC0B4\uC774 \uB110 \uD5A5\uD560\uC9C0 \uBAA8\uB974\uB2C8\uAE4C. \uD14C\uC624\uCC98\uB7FC\u2026
      \uC5B5\uC6B8\uD558\uAC8C \uB2F9\uD560 \uC218\uB3C4 \uC788\uC5B4."
