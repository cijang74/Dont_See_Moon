  - ID: 1
    speakerPosition: Left
    speakerName: "\uC5D8\uB77C"
    listenerName: 
    dialogueText: "\uC81C\uC784\uC2A4 \uB9D0\uC774\uC57C. \uC790\uAE30\uAC00 \uBB34\uC2A8
      \uB300\uB2E8\uD55C \uAD6C\uC6D0\uC790\uB77C\uB3C4 \uB418\uB294 \uC904 \uC544\uB098
      \uBCF8\uB370, \uC6C3\uAE30\uC9C0\uB3C4 \uC54A\uC544."
    nextID: 
    events: []
    emotion: 
    choices:
    - text: 
      nextID: 
