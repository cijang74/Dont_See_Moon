  - ID: 2
    speakerPosition: Left
    speakerName: "\uC5D8\uB77C"
    listenerName: 
    dialogueText: "\uADF8\uB0E5 \uD798\uC73C\uB85C \uCC0D\uC5B4 \uB204\uB974\uACE0,
      \uC790\uAE30 \uB9C8\uC74C\uC5D0 \uC548 \uB4E4\uBA74 \uB2E4 \uAC10\uC5FC\uC790
      \uD551\uACC4\uB85C \uC5C6\uC560\uBC84\uB9AC\uB294 \uD3ED\uAD70\uC77C \uBFD0\uC774\uC57C."
    nextID: 
    events: []
    emotion: 
    choices:
    - text: 
      nextID: 
      effects: []
      requiredEvidence: 0
