  title: 
  dialogueLines:
  - ID: 0
    speakerPosition: Left
    speakerName: "\uC81C\uC784\uC2A4"
    listenerName: 
    dialogueText: "\uB2E4\uB4E4 \uBAA8\uC600\uB098. \uB9C9\uB0B4, \uC624\uB298\uB3C4
      \uB124 \uC5C5\uBB34\uB97C \uC131\uC2E4\uD788 \uD574\uB0C8\uAD70. \uB355\uBD84\uC5D0
      \uB300\uD53C\uC18C\uAC00 \uC798 \uAD74\uB7EC\uAC00\uACE0 \uC788\uC5B4."
    nextID: 1
    events: []
    emotion: 
    choices:
    - text: 
      nextID: 
      effects: []
      requiredEvidence: 0
    - text: 
      nextID: 
      effects: []
      requiredEvidence: 0
    - text: 
      nextID: 
      effects: []
      requiredEvidence: 0
  - ID: 1
    speakerPosition: Left
    speakerName: "\uC81C\uC784\uC2A4"
    listenerName: 
    dialogueText: "\uADF8\uB7FC \uD68C\uC758\uB97C \uC2DC\uC791\uD558\uC9C0. \uC624\uB298
      \uB300\uD53C\uC18C \uC548\uC5D0\uC11C \uC218\uC0C1\uD55C \uC810\uC744 \uBC1C\uACAC\uD55C
      \uC0AC\uB78C \uC788\uB098?"
    nextID: 
    events: []
    emotion: 
    choices:
    - text: "\uC544\uBB34\uAC83\uB3C4 \uC5C6\uC5C8\uC2B5\uB2C8\uB2E4."
      nextID: 4
      effects: []
      requiredEvidence: 0
    - text: "\uC57C\uAD6C \uBC30\uD2B8\uB97C \uBC1C\uACAC\uD588\uC2B5\uB2C8\uB2E4."
      nextID: 2
      effects:
      - effectType: 1
        effectSubject: 2
        effectTarget: 4
        effectAmount: 15
      - effectType: 1
        effectSubject: 3
        effectTarget: 4
        effectAmount: 15
      - effectType: 1
        effectSubject: 5
        effectTarget: 4
        effectAmount: 15
      requiredEvidence: 8
    - text: "\uBE68\uB798 \uBC14\uAD6C\uB2C8\uB97C \uBC1C\uACAC\uD588\uC2B5\uB2C8\uB2E4."
      nextID: 3
      effects: []
      requiredEvidence: 9
  - ID: 2
    speakerPosition: Left
    speakerName: "\uC81C\uC784\uC2A4"
    listenerName: 
    dialogueText: "\uC774 \uBC30\uD2B8... \uC5D8\uB77C, \uB124\uAC00 \uBC24\uC5D0
      \uBABD\uC720\uBCD1\uC774\uB77C\uB3C4 \uC553\uACE0 \uC788\uB294 \uAC74\uAC00?
      \uC544\uC8FC \uC758\uC2EC\uC2A4\uB7EC\uC6B4 \uD754\uC801\uC774\uAD70."
    nextID: 4
    events: []
    emotion: 
    choices:
    - text: 
      nextID: 
      effects: []
      requiredEvidence: 0
    - text: 
      nextID: 
      effects: []
      requiredEvidence: 0
    - text: 
      nextID: 
      effects: []
      requiredEvidence: 0
  - ID: 3
    speakerPosition: Left
    speakerName: "\uC81C\uC784\uC2A4"
    listenerName: 
    dialogueText: "...\uB0B4 \uC9D0 \uBC14\uAD6C\uB2C8\uAC00 \uC65C? \uB0B4 \uC11C\uB958\uAC00
      \uAC70\uAE30 \uB4E4\uC5B4\uC788\uC5C8\uB2E4\uACE0? \uD765, \uC5B5\uC9C0 \uBD80\uB9AC\uC9C0
      \uB9C8\uB77C."
    nextID: 4
    events: []
    emotion: 
    choices:
